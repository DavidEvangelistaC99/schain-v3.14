
      subroutine get_path(fqual_temp)

!      create table of magnetic field components

!      character*47 L

      character(1024) :: fqual_temp
      character(512) :: ppath
      character(512) :: cpath
!     Meson compiles this during installation
      ppath = "@BFMODEL_PATH@"
      cpath = "/"    
!      write(*,*) "Len:", L
      fqual_temp = trim(ppath)//trim(cpath)
!      write(*,*) "Len:", fqual_temp
      return
      end
